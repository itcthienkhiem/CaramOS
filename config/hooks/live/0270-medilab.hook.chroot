#!/bin/bash
# Hook: cài sẵn Medilab (AKSOFT) + .NET 8 Desktop Runtime vào OS qua Wine.
# Build-time: tải bộ cài, dựng SẴN Wine prefix (Xvfb headless) tại /opt/medilab/wineprefix.
# First-run: copy prefix-template sang home người dùng (đã cài sẵn). Dự phòng: cài lại.
export DEBIAN_FRONTEND=noninteractive

echo "[SenOS] === Cài sẵn Medilab (AKSOFT) vào OS ==="

MDIR=/opt/medilab
INST="$MDIR/installers"
mkdir -p "$INST"

SETUP_URL="https://www.dropbox.com/scl/fi/ul285bcvklwuxmp18cpup/Setup.exe?rlkey=mmh3tot6w7br40cni8kkwvovu&dl=1"
DOTNET_URL="https://www.dropbox.com/scl/fi/hwnbmy6f6rs28dm52cqpf/windowsdesktop-runtime-8.0.28-win-x64.exe?rlkey=01tetda92b04bir2jbumf3hz3&dl=1"

echo "[Medilab] Tải bộ cài Medilab (~115MB)..."
wget -q -O "$INST/Setup.exe" "$SETUP_URL" || echo "[WARN] tải Setup.exe thất bại"
echo "[Medilab] Tải .NET 8 Desktop Runtime (~56MB)..."
wget -q -O "$INST/windowsdesktop-runtime-8.0.28-win-x64.exe" "$DOTNET_URL" || echo "[WARN] tải .NET runtime thất bại"
ls -lh "$INST" || true

# ---------------------------------------------------------------------------
# CÀI SẴN LÚC BUILD: Wine không chạy bằng root -> dùng user tạm + Xvfb headless.
# ---------------------------------------------------------------------------
echo "[Medilab] Cài Xvfb + dựng Wine prefix sẵn (best-effort, có timeout)..."
apt-get install -y --no-install-recommends xvfb >/dev/null 2>&1 || echo "[WARN] không cài được xvfb"

BUSER=winebld
# System user (uid < 1000) -> không đụng uid 1000 của live user, không hiện ở greeter.
id "$BUSER" >/dev/null 2>&1 || useradd -r -m -d /home/"$BUSER" -s /bin/bash "$BUSER"
mkdir -p "$MDIR/wineprefix"
chown -R "$BUSER:$BUSER" "$MDIR"

cat > /tmp/medilab-buildinstall.sh <<'BUILDINSTALL'
#!/bin/bash
export WINEPREFIX=/opt/medilab/wineprefix
export WINEARCH=win64
export WINEDEBUG=-all
export WINEDLLOVERRIDES="mscoree=d;mshtml=d"
export DISPLAY=
echo "  -> copy fonts (gồm Tahoma + font Windows có tiếng Việt) TRƯỚC wineboot"
mkdir -p "$WINEPREFIX/drive_c/windows/Fonts"
find /usr/share/fonts -type f \( -iname '*.ttf' -o -iname '*.otf' \) \
    -exec cp -f {} "$WINEPREFIX/drive_c/windows/Fonts/" \; 2>/dev/null || true
echo "  -> wineboot init (đăng ký font)"
timeout 300 xvfb-run -a wineboot -u >/dev/null 2>&1 || true
echo "  -> đăng ký Tahoma + MS Shell Dlg trong registry"
cat > /tmp/medi-fonts.reg <<'REG'
REGEDIT4

[HKEY_LOCAL_MACHINE\Software\Microsoft\Windows NT\CurrentVersion\Fonts]
"Tahoma (TrueType)"="tahoma.ttf"
"Tahoma Bold (TrueType)"="tahomabd.ttf"
"Microsoft Sans Serif (TrueType)"="micross.ttf"
"Segoe UI (TrueType)"="segoeui.ttf"
"Arial (TrueType)"="arial.ttf"

[HKEY_LOCAL_MACHINE\Software\Microsoft\Windows NT\CurrentVersion\FontSubstitutes]
"MS Shell Dlg"="Tahoma"
"MS Shell Dlg 2"="Tahoma"
"Helv"="Tahoma"
"System"="Tahoma"
REG
timeout 120 xvfb-run -a wine regedit /S /tmp/medi-fonts.reg >/dev/null 2>&1 || true
echo "  -> install .NET 8 desktop runtime"
timeout 600 xvfb-run -a wine /opt/medilab/installers/windowsdesktop-runtime-8.0.28-win-x64.exe /install /quiet /norestart >/dev/null 2>&1 || true
echo "  -> install Medilab (silent)"
timeout 900 xvfb-run -a wine /opt/medilab/installers/Setup.exe /exenoui /qn >/dev/null 2>&1 || true
echo "  -> build-time install done"
BUILDINSTALL
chmod +x /tmp/medilab-buildinstall.sh
chown "$BUSER:$BUSER" /tmp/medilab-buildinstall.sh
runuser -u "$BUSER" -- /tmp/medilab-buildinstall.sh || true
rm -f /tmp/medilab-buildinstall.sh

# Dọn user tạm TRIỆT ĐỂ (nếu sót sẽ chiếm uid 1000 -> hỏng auto-login live).
runuser -u "$BUSER" -- bash -c 'WINEPREFIX=/opt/medilab/wineprefix wineserver -k' 2>/dev/null || true
pkill -9 -u "$BUSER" 2>/dev/null || true
sleep 2
# Giữ prefix làm template (root sở hữu) để copy sang từng user.
chown -R root:root "$MDIR"
userdel -f "$BUSER" 2>/dev/null || true
sed -i "/^${BUSER}:/d" /etc/passwd /etc/shadow /etc/group /etc/gshadow 2>/dev/null || true
rm -rf /home/"$BUSER"
if id "$BUSER" >/dev/null 2>&1; then echo "[WARN] user tạm $BUSER vẫn còn!"; else echo "[OK] đã xoá user tạm $BUSER"; fi

if find "$MDIR/wineprefix" -iname 'Medilab.exe' 2>/dev/null | grep -q .; then
    echo "[OK] Đã cài sẵn Medilab vào prefix template."
else
    echo "[WARN] Cài sẵn lúc build chưa thấy Medilab.exe — sẽ cài lại khi mở lần đầu."
fi

# --- Script cài đặt lần đầu (dự phòng / cài lại) ---
cat > /usr/local/bin/medilab-install <<'INSTALL'
#!/bin/bash
set -u
INST=/opt/medilab/installers
export WINEPREFIX="$HOME/.local/share/medilab/wine"
export WINEARCH=win64
export WINEDEBUG=-all
echo "================ Cài đặt Medilab (AKSOFT) ================"
mkdir -p "$WINEPREFIX"
echo "[1/4] Khởi tạo Wine prefix..."
wineboot -u >/dev/null 2>&1 || true
echo "[2/4] Cài font..."
mkdir -p "$WINEPREFIX/drive_c/windows/Fonts"
find /usr/share/fonts -type f \( -iname '*.ttf' -o -iname '*.otf' \) -exec cp -f {} "$WINEPREFIX/drive_c/windows/Fonts/" \; 2>/dev/null || true
command -v winetricks >/dev/null 2>&1 && winetricks -q corefonts >/dev/null 2>&1 || true
echo "[3/4] Cài .NET 8 Desktop Runtime..."
[ -f "$INST/windowsdesktop-runtime-8.0.28-win-x64.exe" ] && \
  { wine "$INST/windowsdesktop-runtime-8.0.28-win-x64.exe" /install /quiet /norestart 2>/dev/null || wine "$INST/windowsdesktop-runtime-8.0.28-win-x64.exe" 2>/dev/null || true; }
echo "[4/4] Cài Medilab..."
[ -f "$INST/Setup.exe" ] && { wine "$INST/Setup.exe" /exenoui /qn 2>/dev/null || wine "$INST/Setup.exe" 2>/dev/null || true; }
echo "Hoàn tất."
command -v notify-send >/dev/null 2>&1 && notify-send "Medilab" "Cài đặt xong." || true
read -p "Nhấn Enter để đóng..." _ 2>/dev/null || true
INSTALL
chmod +x /usr/local/bin/medilab-install

# --- Script chạy Medilab (dùng prefix cài sẵn nếu có) ---
cat > /usr/local/bin/medilab-run <<'RUN'
#!/bin/bash
export WINEDEBUG=-all
UPREFIX="$HOME/.local/share/medilab/wine"
# Lần đầu: nếu có prefix-template đã cài sẵn lúc build -> copy sang home (nhanh)
if [ ! -d "$UPREFIX" ] && [ -d /opt/medilab/wineprefix ] && find /opt/medilab/wineprefix -iname 'Medilab.exe' 2>/dev/null | grep -q .; then
    mkdir -p "$(dirname "$UPREFIX")"
    cp -a /opt/medilab/wineprefix "$UPREFIX"
fi
export WINEPREFIX="$UPREFIX"
EXE=$(find "$UPREFIX" -iname 'Medilab.exe' 2>/dev/null | head -1)
if [ -z "$EXE" ]; then
    x-terminal-emulator -e /usr/local/bin/medilab-install 2>/dev/null || gnome-terminal -- /usr/local/bin/medilab-install 2>/dev/null || /usr/local/bin/medilab-install
    EXE=$(find "$UPREFIX" -iname 'Medilab.exe' 2>/dev/null | head -1)
fi
[ -n "$EXE" ] && exec wine "$EXE"
RUN
chmod +x /usr/local/bin/medilab-run

# --- Desktop launchers + icon ---
cat > /usr/share/applications/medilab.desktop <<'DESK'
[Desktop Entry]
Type=Application
Name=Medilab
Comment=Phần mềm Medilab (AKSOFT) — chạy qua Wine
Exec=/usr/local/bin/medilab-run
Icon=senos-logo
Terminal=false
Categories=Office;Science;
StartupNotify=true
DESK
cat > /usr/share/applications/medilab-install.desktop <<'DESK2'
[Desktop Entry]
Type=Application
Name=Cài đặt lại Medilab
Comment=Cài/cài lại Medilab qua Wine
Exec=/usr/local/bin/medilab-install
Icon=senos-logo
Terminal=true
Categories=System;
DESK2
mkdir -p /etc/skel/Desktop
cp -f /usr/share/applications/medilab.desktop /etc/skel/Desktop/medilab.desktop
chmod +x /etc/skel/Desktop/medilab.desktop
gio set /etc/skel/Desktop/medilab.desktop metadata::trusted true 2>/dev/null || true

echo "[OK] Đóng gói Medilab xong."
